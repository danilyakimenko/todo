{
  "name": "todo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "json-server db.json5 --watch --port 3001",
    "build": "vite build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview",
    "copy404": "cpy dist/index.html dist --rename=404.html --flat",
    "predeploy": "run-s build copy404",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "cpy-cli": "^7.0.0",
    "gh-pages": "^6.3.0",
    "json-server": "^1.0.0-beta.15",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.81.0",
    "sass": "^1.104.1",
    "vite": "^8.3.0"
  }
}
